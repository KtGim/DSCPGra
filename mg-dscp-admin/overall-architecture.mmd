        AppMain --> Views["业务页面 views/ (28 个业务域)"]
        Views --> VComps["页面私有组件<br/>views/**/components"]
    end

    subgraph COMP["公共组件层 src/components (45 个)"]
        CustomTable["CustomTable<br/>JSON 配置化表格 + 虚拟滚动"]
        CustomForm["CustomForm<br/>JSON 配置化表单"]
        SearchTable["SearchTable<br/>查询+列表组合范式"]
        Pagination["Pagination<br/>分页/游标/异步总数"]
        Uploads["FileUpload / FileImportUpload<br/>ImageUploadOSS(OSS直传)"]
        Inputs["BatchSearchInput / BulkSearch<br/>CustomSelect / QuickFilter / Tags"]
        Tools["FrontTools(Excel→PDF)<br/>Editor / CountryDialog / VirtualList"]
        custom["index.js 具名导出<br/>(仅 Pagination/RightToolbar 全局注册)"]
    end

    subgraph INFRA["基础设施层"]
        Router["router/index.js<br/>静态路由 constantRoutes"]
