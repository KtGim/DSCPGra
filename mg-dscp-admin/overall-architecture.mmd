        Plugins["plugins/<br/>$auth / $cache / $modal / $tab"]
        Utils["utils/<br/>request.js / rice.js / batchRequest.js<br/>auth.js / storage.js / formatMoney.js"]
    end

    subgraph API["API 层 src/api (21 个模块, 89 文件)"]
        ALogin["login.js<br/>/login /getInfo /logout /captchaImage"]
        AMenu["menu.js<br/>/getRouters 动态菜单"]
        ABiz["业务 API<br/>business/product/billManage/freight/..."]
        AOSS["ossAli.js<br/>阿里云 OSS 前端直传"]
    end

    subgraph BACK["后端服务"]
        B["民光后端网关<br/>https://*.dropshipchinapro.com/api"]
